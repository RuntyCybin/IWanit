# Copy this file to .env and adjust values for your environment.
# docker-compose reads .env automatically.

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host-side port for Postgres (container always listens on 5432 internally).
# Change this if 5433 is already taken on your machine.
POSTGRES_HOST_PORT=5433

# Used to sign JWTs; override with a strong random value in real deployments.
JWT_SECRET=pVOJEjRLoScmU4pRKHJugioAu2ffsNz6etSYWHtkOY4
